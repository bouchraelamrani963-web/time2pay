# --- Database (Neon) ---
DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# --- Firebase Web SDK (public) ---
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# --- Firebase Admin SDK (server-only) ---
# From the service account JSON downloaded in Firebase console:
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Keep the literal \n escapes — they are converted at runtime:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
