# --- Database (Neon) ---
DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# --- Firebase Web SDK (public) ---
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# --- Firebase Admin SDK (server-only) ---
# From the service account JSON downloaded in Firebase console:
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Keep the literal \n escapes — they are converted at runtime:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional server-only Firebase UID of the platform owner with an active support role.
# Leave blank to deny all access to /admin.
TIME2PAY_PLATFORM_ADMIN_UID=""


# Mollie Connect (merchant-owned payments). NEVER reuse Stripe subscription credentials.
# Default OFF; test environment has separate app, database and key from production.
MOLLIE_PAYMENT_LINKS_ENABLED="false"
MOLLIE_ENABLE_LIVE_PAYMENTS="false"
MOLLIE_CLIENT_ID=""
MOLLIE_CLIENT_SECRET=""
MOLLIE_REDIRECT_URI="https://test.example.com/api/mollie/callback"
MOLLIE_PUBLIC_URL="https://test.example.com"
# Generate 32 random bytes and encode as Base64. Keep out of Git.
MOLLIE_TOKEN_ENCRYPTION_KEY=""
