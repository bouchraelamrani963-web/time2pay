{
  "name": "time2pay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/enable-test-totp.cjs && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test:billing": "node --test tests/billing-access.test.mjs tests/billing-routes.test.cjs tests/invoice-email.test.cjs",
    "test:services": "node --test tests/service-rates.test.cjs",
    "test:auth": "node --test tests/auth-mfa.test.cjs",
    "test:quota": "node --test tests/invoice-quota.test.cjs",
    "test:security-notices": "node --test tests/security-notice.test.cjs",
    "test:recovery": "node --test tests/auth-recovery.test.cjs tests/auth-recovery-db.test.cjs"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "firebase": "13.1.0",
    "firebase-admin": "14.5.0",
    "lucide-react": "^0.462.0",
    "next": "16.4.3",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hot-toast": "^2.4.1",
    "resend": "^6.16.0",
    "stripe": "^22.6.0",
    "workflow": "5.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6",
    "zod": "$zod",
    "undici": "^7.30.1",
    "@grpc/grpc-js": "^1.14.6",
    "jwks-rsa": {
      "jose": "^5.10.0"
    }
  }
}
